{
  "name": "koyomi-app",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "prebuild:ios": "expo prebuild --platform ios && node scripts/fix-entitlements.js",
    "ios:clean": "rm -rf node_modules package-lock.json ios && npm install && npm run prebuild:ios && npx expo run:ios --device"
  },
  "dependencies": {
    "@bacons/apple-targets": "^5.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/slider": "5.0.1",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "expo": "^54.0.36",
    "expo-build-properties": "~1.0.10",
    "expo-file-system": "~19.0.23",
    "expo-iap": "^4.5.2",
    "expo-image-picker": "~17.0.11",
    "expo-media-library": "~18.2.1",
    "expo-notifications": "~0.32.0",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-view-shot": "4.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "typescript": "~5.9.2"
  }
}
